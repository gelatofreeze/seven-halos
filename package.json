{
  "name": "seven-halos",
  "version": "0.1.0",
  "private": true,
  "description": "SEVEN HALOS \u2014 a 2D pixel-art dark-fantasy action RPG built with Phaser and TypeScript.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && vite build && node scripts/verify-commercial-build.mjs",
    "build:test": "VITE_DEV_TOOLS=true vite build"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
